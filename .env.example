# ============================================================
# Database (TimescaleDB inside Docker)
# ============================================================
POSTGRES_USER=signal
POSTGRES_PASSWORD=GENERATE_LONG_RANDOM_STRING_HERE
POSTGRES_DB=signal_platform
DATABASE_URL=postgresql://signal:GENERATE_LONG_RANDOM_STRING_HERE@postgres:5432/signal_platform

# ============================================================
# Redis (inside Docker)
# ============================================================
REDIS_URL=redis://redis:6379/0

# ============================================================
# Auth0 (filled in during Step 8)
# ============================================================
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://signal.cimcha.com/api
AUTH0_CLIENT_ID=your_client_id_here
AUTH0_CLIENT_SECRET=your_client_secret_here

# ============================================================
# Binance.US (filled in during Step 5)
# ============================================================
BINANCEUS_API_KEY=your_binanceus_key_here
BINANCEUS_API_SECRET=your_binanceus_secret_here

# ============================================================
# Frontend (Next.js)
# ============================================================
NEXT_PUBLIC_API_URL=https://signal.cimcha.com
NEXT_PUBLIC_WS_URL=wss://signal.cimcha.com
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your_client_id_here
NEXT_PUBLIC_AUTH0_AUDIENCE=https://signal.cimcha.com/api

# ============================================================
# Settings encryption (used to encrypt API keys at rest)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================
SETTINGS_ENCRYPTION_KEY=GENERATE_VIA_THE_COMMAND_ABOVE

# ============================================================
# Application
# ============================================================
ENV=production
LOG_LEVEL=INFO

# Phase 1 ingestion scope (canonical symbols, comma-separated)
INGESTION_SYMBOLS=BTC-USDT@BINANCEUS,ETH-USDT@BINANCEUS
