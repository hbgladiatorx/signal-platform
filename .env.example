# ============================================================
# Signal Platform — environment template
# ------------------------------------------------------------
# Copy to `.env` (never commit the real .env) and fill values.
# The backend containers (api, ingestion_*, workers) read this via
# `env_file: .env`. The frontend (thebayn) only receives the single key
# explicitly passed in docker-compose.yml (see FRONTEND section).
#
# Legend:  [required]  needed for the core stack to run
#          [feature]   needed only for that capability
#          [optional]  has a sane default; override only if you know why
# ============================================================


# ============================================================
# Database — TimescaleDB (inside Docker)                        [required]
# ============================================================
POSTGRES_USER=signal
POSTGRES_PASSWORD=GENERATE_LONG_RANDOM_STRING_HERE
POSTGRES_DB=signal_platform
# Inside Docker the host is the service name `postgres`.
DATABASE_URL=postgresql://signal:GENERATE_LONG_RANDOM_STRING_HERE@postgres:5432/signal_platform
# Only set these if not using DATABASE_URL / running outside compose:
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# Connection pool tuning [optional]
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10


# ============================================================
# Redis (inside Docker)                                         [required]
# ============================================================
REDIS_URL=redis://redis:6379/0


# ============================================================
# Auth — Supabase                                               [required]
# ------------------------------------------------------------
# The frontend uses Supabase (URL + anon key are baked into the client
# bundle). The API verifies those JWTs. SUPABASE_URL has a built-in
# default for this project; override only for a different Supabase project.
# ============================================================
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Expected audience claim on Supabase JWTs (default: authenticated)
# SUPABASE_JWT_AUD=authenticated


# ============================================================
# Application / API                                             [required]
# ============================================================
ENV=production
LOG_LEVEL=INFO
# Comma-separated allowed origins for the API's CORS.
CORS_ORIGINS=https://signal.cimcha.com
# Encrypts per-user broker API keys at rest (Settings → API credentials).
# REQUIRED before any broker key can be saved in the app.
# Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SETTINGS_ENCRYPTION_KEY=GENERATE_VIA_THE_COMMAND_ABOVE


# ============================================================
# AI — Copilot / strategy builder (Anthropic)                   [feature]
# ------------------------------------------------------------
# Without this, the Studio Copilot, graph planner, narration and tweak
# advisor return a clear "not configured" message.
# ============================================================
ANTHROPIC_API_KEY=sk-ant-your_key_here
# Model overrides [optional] — sensible defaults are used if unset.
# COPILOT_MODEL=
# GRAPH_PLANNER_MODEL=
# LLM_TRANSLATOR_MODEL=
# NARRATE_MODEL=
# TWEAK_ADVISOR_MODEL=


# ============================================================
# Market data — CRYPTO (Binance.US)                             [feature]
# ============================================================
BINANCEUS_API_KEY=your_binanceus_key_here
BINANCEUS_API_SECRET=your_binanceus_secret_here
# Ingestion scope: "*"/"all" = full active universe (run
#   python -m packages.data.universe.binanceus_discovery  first);
# or a comma-separated canonical list; empty = idle.
INGESTION_SYMBOLS=BTC-USDT@BINANCEUS,ETH-USDT@BINANCEUS
# L1 quotes default OFF at scale; set to 1 to force on for a subset. [optional]
INGESTION_BINANCEUS_QUOTES=


# ============================================================
# Market data — STOCKS / OPTIONS                                [feature]
# ------------------------------------------------------------
# Pick ONE source (or both). Alpaca's IEX feed is FREE and works with a
# standard Alpaca account — recommended if you don't have Polygon.
# ============================================================

# ---- Option A: Alpaca market data (free IEX) ----
# Can reuse the same Alpaca key/secret as the trading credential below.
ALPACA_DATA_KEY_ID=your_alpaca_key
ALPACA_DATA_SECRET=your_alpaca_secret
ALPACA_DATA_FEED=iex           # "iex" (free, 1 connection) or "sip" (paid)
ALPACA_INGEST_QUOTES=0         # 1 to also stream L1 quotes [optional]
INGESTION_ALPACA_SYMBOLS=SPY@ALPACA,AAPL@ALPACA,QQQ@ALPACA,NVDA@ALPACA,MSFT@ALPACA

# ---- Option B: Polygon.io (paid; real-time stocks + options) ----
# Leave POLYGON_API_KEY set but INGESTION_POLYGON_SYMBOLS EMPTY to keep the
# polygon ingester idle (e.g. if the subscription is paused).
POLYGON_API_KEY=
# "*" = full universe (run polygon_stocks_discovery first) | canonical list | empty = idle
INGESTION_POLYGON_SYMBOLS=
INGESTION_POLYGON_CHANNEL=aggregates_sec   # aggregates_sec | aggregates_min | trades
INGESTION_POLYGON_CLUSTER=stocks
INGESTION_POLYGON_ASSET_CLASS=equity
POLYGON_DELAYED=0              # 1 if on a delayed (non-real-time) plan [optional]


# ============================================================
# Broker TRADING credentials — per-user by default (secure)     [feature]
# ------------------------------------------------------------
# SECURE DEFAULT: every user connects their OWN broker key in
# Settings → Broker API keys, and each user only ever trades on their own
# broker account. Nothing below is required for that — leave it unset.
#
# OPTIONAL DEMO MODE: set ALLOW_PLATFORM_CREDENTIALS=true to seed a SHARED
# platform broker key that any user can fall back to (zero-setup paper demo).
# WARNING: a shared key commingles every user's activity on ONE broker
# account — never enable it with a real-money (Binance.US) key in production.
# When true, the keys below are read and seeded at API start:
#   - Alpaca (service "alpaca")   → PAPER stock/option trading.
#   - Binance.US                  → LIVE (real-money) crypto trading.
# ============================================================
ALLOW_PLATFORM_CREDENTIALS=false
# Only used when ALLOW_PLATFORM_CREDENTIALS=true:
ALPACA_API_KEY_ID=your_alpaca_paper_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret
# (Binance.US trading uses the BINANCEUS_API_KEY/SECRET set above.)


# ============================================================
# Frontend runtime (thebayn container)                          [feature]
# ------------------------------------------------------------
# Read by the frontend's server functions. docker-compose.yml passes ONLY
# this key into the thebayn container (backend secrets stay out of the web
# process). Powers the news wire + "add ticker" validation.
# ============================================================
FINNHUB_API_KEY=your_finnhub_key_here


# ============================================================
# Referee (strategy certification signing)                      [optional]
# ============================================================
# Ed25519 private key used to sign certification reports.
# Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REFEREE_ED25519_PRIVATE_KEY=
# REFEREE_CERT_STORE=            # path/URI for the cert store [optional]
# REFEREE_ALLOW_INSECURE=        # 1 to allow unsigned certs in dev only [optional]


# ============================================================
# Ingestion / workers — advanced tuning                         [optional]
# ============================================================
# Horizontal sharding for ingestion workers (stable symbol-hash split).
SHARD_INDEX=0
SHARD_COUNT=1
# Persistence worker batching [optional]
# PERSISTENCE_BATCH_SIZE=
# PERSISTENCE_BATCH_TIMEOUT_MS=
# PERSISTENCE_INSTRUMENT_REFRESH_S=
# Backtest guards [optional]
# BACKTEST_MAX_BARS=
# BACKTEST_STALE_RUNNING_SECONDS=
# STRATEGIES_DIR=
