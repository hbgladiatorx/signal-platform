# ============================================================
# Database (TimescaleDB inside Docker)
# ============================================================
POSTGRES_USER=signal
POSTGRES_PASSWORD=GENERATE_LONG_RANDOM_STRING_HERE
POSTGRES_DB=signal_platform
DATABASE_URL=postgresql://signal:GENERATE_LONG_RANDOM_STRING_HERE@postgres:5432/signal_platform

# ============================================================
# Redis (inside Docker)
# ============================================================
REDIS_URL=redis://redis:6379/0

# ============================================================
# Auth0 (filled in during Step 8)
# ============================================================
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://signal.cimcha.com/api
AUTH0_CLIENT_ID=your_client_id_here
AUTH0_CLIENT_SECRET=your_client_secret_here

# ============================================================
# Binance.US (filled in during Step 5)
# ============================================================
BINANCEUS_API_KEY=your_binanceus_key_here
BINANCEUS_API_SECRET=your_binanceus_secret_here

# ============================================================
# Frontend (Next.js)
# ============================================================
NEXT_PUBLIC_API_URL=https://signal.cimcha.com
NEXT_PUBLIC_WS_URL=wss://signal.cimcha.com
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your_client_id_here
NEXT_PUBLIC_AUTH0_AUDIENCE=https://signal.cimcha.com/api

# ============================================================
# Settings encryption (used to encrypt API keys at rest)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================
SETTINGS_ENCRYPTION_KEY=GENERATE_VIA_THE_COMMAND_ABOVE

# ============================================================
# Application
# ============================================================
ENV=production
LOG_LEVEL=INFO

# Binance.US ingestion scope. "*"/"all" streams the full active universe from
# the instruments table (run `python -m packages.data.universe.binanceus_discovery`
# first to populate it); or a comma-separated canonical list for a subset.
INGESTION_SYMBOLS=BTC-USDT@BINANCEUS,ETH-USDT@BINANCEUS
# L1 quotes default OFF at universe scale; set to 1 to force on for a subset.
INGESTION_BINANCEUS_QUOTES=
# Optional horizontal sharding for ingestion workers (stable symbol-hash split).
SHARD_INDEX=0
SHARD_COUNT=1

# ============================================================
# Polygon.io (stock + options data — "Options Advanced" for real-time)
# ============================================================
POLYGON_API_KEY=pk_your_real_key_here
# Equity universe: run `python -m packages.data.universe.polygon_stocks_discovery`
# then set "*" to stream all, or a canonical list (AAPL@ALPACA,...). Empty = idle.
INGESTION_POLYGON_SYMBOLS=
# Channel: aggregates_sec (default, recommended at scale) | aggregates_min | trades
INGESTION_POLYGON_CHANNEL=aggregates_sec
INGESTION_POLYGON_CLUSTER=stocks
INGESTION_POLYGON_ASSET_CLASS=equity

# Live Alpaca equities/options trading (REAL money) is enabled per-user by
# storing an Alpaca *live* key in api_credentials with service='alpaca_live'
# (Settings UI). No platform-level live key is read from this file.

# ============================================================
# Alpaca equity market data (paper trading Stage 2)
# Platform-level market-data key used by the ingestion_alpaca service.
# Separate from per-user Alpaca *trading* keys (stored encrypted in
# api_credentials via Settings). feed: "iex" (free, 1 connection) or "sip".
# ============================================================
ALPACA_DATA_KEY_ID=your_alpaca_data_key
ALPACA_DATA_SECRET=your_alpaca_data_secret
ALPACA_DATA_FEED=iex
ALPACA_INGEST_QUOTES=0
# Equity symbols to ingest (canonical form, comma-separated)
INGESTION_ALPACA_SYMBOLS=AAPL@ALPACA,SPY@ALPACA
