# Copy to .env and fill in. Never commit real keys.

# --- Providers ---
POLYGON_API_KEY=
FINNHUB_API_KEY=
USASPENDING_API_KEY=          # USASpending is open; SAM.gov needs a key.
SAM_API_KEY=
# SEC EDGAR requires NO key but DOES require a descriptive User-Agent w/ contact.
SEC_USER_AGENT=catalyst-breakout-research you@example.com

# --- Persistence ---
# Offline/test default is sqlite. Production points at Supabase Postgres:
# DATABASE_URL=postgresql://USER:PASS@HOST:5432/postgres
DATABASE_URL=sqlite:///catalyst.db

# --- Live output channel (Module 5 push target) ---
SIGNAL_WEBHOOK_URL=

# --- CONFIG overrides (optional) ---
# Any defaults.py value can be overridden as CATALYST_<SECTION>_<KEY>, e.g.:
# CATALYST_SCREEN_MARKET_CAP_FLOOR_USD=500000000
# CATALYST_CATALYST_MIN_EARNINGS_SURPRISE_PCT=8
