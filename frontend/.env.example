# Frontend environment configuration
# Copy to .env.local for development; on the Lightsail box these
# values are passed via docker-compose env_file.

# Auth0 — Single Page Application credentials (PUBLIC values, safe in browser)
NEXT_PUBLIC_AUTH0_DOMAIN=cimcha-signal.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=NdpXGkOy3f4JWxXhVAOWXddsTBQ4bbsV
NEXT_PUBLIC_AUTH0_AUDIENCE=https://signal.cimcha.com/api
NEXT_PUBLIC_AUTH0_CALLBACK_URL=https://signal.cimcha.com/auth/callback

# API base — used by browser fetches.
# Empty string means "same origin", since Caddy proxies /api/* to the backend.
NEXT_PUBLIC_API_BASE=/api
